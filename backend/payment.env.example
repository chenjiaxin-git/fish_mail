# 默认关闭支付。以下全部配置就绪后再启用；不填入真实密钥并提交仓库。
WECHAT_PAY_ENABLED=false
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_TIMEOUT_MS=5000
# 本文件是环境变量清单，Spring Boot 不会自动加载此文件。
# 部署时由进程环境或容器 env_file 注入，私钥和支付公钥文件通过受限只读挂载提供。
