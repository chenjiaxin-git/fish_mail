# 默认启用：应用启动后首轮和每轮结束后均等待此扫描间隔，会处理已有到期订单。
ORDER_TIMEOUT_CLOSE_ENABLED=true
ORDER_CONFIRM_TIMEOUT_MINUTES=1440
ORDER_TIMEOUT_CLOSE_DELAY_MS=30000
ORDER_TIMEOUT_CLOSE_BATCH_SIZE=50
ORDER_TIMEOUT_CLOSE_MAX_BATCHES=10
ORDER_TIMEOUT_CLOSE_BUDGET_MS=20000
# 网络超时可能使当前单的处理超过本轮预算，预算只阻止继续开始下一单。
# 本文件不会被 Spring 自动加载，需要由部署进程环境或容器 env_file 注入。
# 不更改 WECHAT_PAY_ENABLED。已有支付单无法查单时保留库存，等待重试或人工核查。
