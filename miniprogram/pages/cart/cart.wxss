.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 200rpx;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cart-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e6edf2;
  border-radius: 18rpx;
  background: #ffffff;
}

.cart-card-disabled {
  opacity: 0.6;
}

.check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-top: 30rpx;
  border: 2rpx solid #b7c3ce;
  border-radius: 50%;
  background: #ffffff;
  flex-shrink: 0;
}

.check-box-disabled {
  border-color: #dce5ed;
  background: #f2f5f8;
}

.check-dot {
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
}

.check-box .check-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #0b3b60;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #eef3f6;
  flex-shrink: 0;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b9aa7;
  font-size: 22rpx;
}

.cart-info {
  flex: 1;
  min-width: 0;
}

.cart-name {
  display: block;
  overflow: hidden;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-spec {
  display: block;
  margin-top: 6rpx;
  color: #8b9aa7;
  font-size: 22rpx;
}

.cart-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.cart-price {
  color: #e86b4f;
  font-size: 24rpx;
  font-weight: 600;
}

.cart-reason {
  color: #b5523e;
  font-size: 22rpx;
}

.cart-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.quantity-box {
  display: flex;
  align-items: center;
  height: 60rpx;
  overflow: hidden;
  border: 1rpx solid #dce5ed;
  border-radius: 12rpx;
  background: #ffffff;
}

.quantity-btn {
  width: 58rpx;
  height: 60rpx;
  color: #0b3b60;
  font-size: 30rpx;
  line-height: 60rpx;
  text-align: center;
}

.quantity-input {
  width: 90rpx;
  height: 60rpx;
  color: #1f2937;
  font-size: 24rpx;
  text-align: center;
}

.cart-amount {
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 600;
}

.delete-button {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #f2f5f8;
  color: #8b9aa7;
  font-size: 22rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e6edf2;
  background: #ffffff;
}

.all-select {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.all-select .check-box {
  margin-top: 0;
}

.all-text {
  color: #536575;
  font-size: 26rpx;
}

.total-box {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
}

.total-label {
  color: #536575;
  font-size: 24rpx;
}

.total-price {
  color: #e86b4f;
  font-size: 36rpx;
  font-weight: 600;
}

.checkout-button {
  height: 76rpx;
  margin: 0;
  padding: 0 36rpx;
  border-radius: 16rpx;
  background: #e86b4f;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}

.checkout-button-disabled {
  background: #c7d0d8;
  color: #ffffff;
}

.state-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 420rpx;
  padding: 32rpx;
  border: 1rpx solid #e6edf2;
  border-radius: 18rpx;
  background: #ffffff;
}

.state-title {
  color: #0b3b60;
  font-size: 30rpx;
  font-weight: 600;
}

.state-message {
  margin-top: 12rpx;
  color: #8b9aa7;
  font-size: 24rpx;
  text-align: center;
}

.error-panel .state-title {
  color: #c95b46;
}

.retry-button {
  height: 76rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #0b3b60;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  background: #eef3f6;
  color: #8b9aa7;
  font-size: 30rpx;
}

.loading-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #dce5ed;
  border-top-color: #0b3b60;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
