.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dce5ed;
  border-radius: 16rpx;
  background: #ffffff;
}

.search-icon {
  margin-right: 12rpx;
  color: #6b7c8c;
  font-size: 36rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  color: #1f2937;
  font-size: 28rpx;
}

.search-placeholder {
  color: #9aa8b5;
}

.clear-button {
  padding: 8rpx 0 8rpx 16rpx;
  color: #9aa8b5;
  font-size: 36rpx;
}

.search-button,
.retry-button {
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #0b3b60;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}

.banner-wrap {
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #dceaf2;
}

.banner-swiper,
.banner-item,
.banner-image,
.banner-placeholder {
  width: 100%;
  height: 300rpx;
}

.banner-image {
  display: block;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef3f6;
  color: #8b9aa7;
  font-size: 24rpx;
  text-align: center;
}

.banner-placeholder {
  background: #dceaf2;
}

.meta-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #f0c5bb;
  border-radius: 14rpx;
  background: #fff4f1;
  color: #b5523e;
  font-size: 24rpx;
}

.text-retry {
  margin: 0;
  padding: 0;
  background: transparent;
  color: #0b3b60;
  font-size: 24rpx;
  line-height: inherit;
}

.section {
  margin-bottom: 28rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #0b3b60;
  font-size: 34rpx;
  font-weight: 600;
}

.section-subtitle {
  margin-left: 16rpx;
  color: #8b9aa7;
  font-size: 24rpx;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 2rpx 0;
}

.category-chip {
  min-width: 112rpx;
  padding: 14rpx 26rpx;
  border: 1rpx solid #dce5ed;
  border-radius: 999rpx;
  background: #ffffff;
  color: #536575;
  font-size: 26rpx;
  text-align: center;
}

.category-chip-active {
  border-color: #0b3b60;
  background: #0b3b60;
  color: #ffffff;
}

.empty-category {
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #8b9aa7;
  text-align: center;
}

.product-heading {
  align-items: center;
}

.product-count {
  color: #8b9aa7;
  font-size: 24rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: calc(50% - 9rpx);
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e6edf2;
  border-radius: 18rpx;
  background: #ffffff;
}

.product-image-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  background: #eef3f6;
}

.product-image,
.product-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-placeholder {
  padding: 20rpx;
}

.sold-out-tag {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(11, 59, 96, 0.84);
  color: #ffffff;
  font-size: 20rpx;
}

.product-info {
  padding: 16rpx 18rpx 20rpx;
}

.product-name,
.product-subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-name {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 600;
}

.product-subtitle {
  margin-top: 6rpx;
  color: #8b9aa7;
  font-size: 22rpx;
}

.product-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-price {
  color: #e86b4f;
  font-size: 30rpx;
  font-weight: 600;
}

.product-stock {
  color: #4b8b70;
  font-size: 20rpx;
}

.state-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 280rpx;
  padding: 32rpx;
  border: 1rpx solid #e6edf2;
  border-radius: 18rpx;
  background: #ffffff;
}

.state-title {
  color: #0b3b60;
  font-size: 30rpx;
  font-weight: 600;
}

.state-message {
  margin-top: 12rpx;
  color: #8b9aa7;
  font-size: 24rpx;
  text-align: center;
}

.error-panel .state-title {
  color: #c95b46;
}

.retry-button {
  margin-top: 24rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  background: #eef3f6;
  color: #8b9aa7;
  font-size: 30rpx;
}

.loading-dot {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #dce5ed;
  border-top-color: #0b3b60;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.load-more {
  padding: 28rpx 0 8rpx;
  color: #8b9aa7;
  font-size: 24rpx;
  text-align: center;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
