<view class="page-shell">
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">联系人</text>
      <input
        class="form-input"
        value="{{contactName}}"
        maxlength="50"
        placeholder="收货人姓名"
        placeholder-class="form-placeholder"
        bindinput="onNameInput"
      />
      <text class="form-counter">{{contactName.length}}/50</text>
    </view>

    <view class="form-row">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        value="{{phone}}"
        maxlength="20"
        placeholder="11 位手机号"
        placeholder-class="form-placeholder"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-row form-row-column">
      <view class="form-label-line">
        <text class="form-label">详细地址</text>
        <text class="form-counter">{{detailAddress.length}}/200</text>
      </view>
      <textarea
        class="form-textarea"
        value="{{detailAddress}}"
        maxlength="200"
        placeholder="街道、门牌号等"
        placeholder-class="form-placeholder"
        bindinput="onDetailInput"
      />
    </view>

    <view class="form-row form-row-switch">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#0B3B60" bindchange="onDefaultChange" />
    </view>
  </view>

  <button class="save-button {{saving ? 'save-button-disabled' : ''}}" disabled="{{saving}}" bindtap="onSaveTap">{{saveText}}</button>
</view>
