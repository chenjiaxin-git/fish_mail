.page { padding: 24rpx; min-height: 100vh; }
.tabs { display: flex; background: white; border-radius: 14rpx; margin-bottom: 24rpx; }
.tab { flex: 1; padding: 24rpx 0; text-align: center; font-size: 26rpx; }
.selected { color: #0b3b60; font-weight: bold; border-bottom: 4rpx solid #0b3b60; }
.card { background: white; border-radius: 18rpx; padding: 24rpx; margin-bottom: 20rpx; }
.row { display: flex; justify-content: space-between; gap: 16rpx; font-size: 25rpx; }
.status { color: #0b3b60; flex-shrink: 0; }
.product { display: flex; align-items: center; gap: 20rpx; margin: 24rpx 0; }
image, .placeholder { width: 110rpx; height: 110rpx; border-radius: 12rpx; flex-shrink: 0; }
.placeholder { background: #eef3f6; color: #8b9aa7; font-size: 22rpx; line-height: 110rpx; text-align: center; }
.muted { color: #788a99; font-size: 25rpx; margin-top: 8rpx; }
.amount { text-align: right; margin-top: 16rpx; font-weight: bold; }
.countdown { color: #ad6516; font-size: 25rpx; margin-top: 12rpx; }
.empty { color: #788a99; padding: 40rpx; text-align: center; }
